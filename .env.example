# --- LLM (OpenAI-совместимый) ---
# Укажите ваш ключ. Можно также использовать локальный сервер (Ollama/vLLM и т.п.):
#   AI_MODEL=gpt-4o-mini (имя модели у провайдера)
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
# Повторы временных ошибок провайдера (502/503/504 и т.п.)
OPENAI_MAX_RETRIES=5
# Максимум запросов к модели за один запуск агента (исследователь/критик/писатель)
AGENT_REQUEST_LIMIT=100

# Порт бэкенда на хосте (порт внутри Docker остается 8000)
BACKEND_PORT=8001

# --- Защищённая админка (/admin) ---
# Обязательно задайте длинный уникальный пароль (не менее 16 символов).
ADMIN_PASSWORD=

# Модель критика (по умолчанию = AI_MODEL). Можно взять модель слабее/сильнее
CRITIC_MODEL=

# --- Лимиты контекстного окна ---
# Примерный бюджет входного контекста модели (для оценки объёма файлов)
CONTEXT_TOKEN_LIMIT=120000
# Максимальный объем одной порции чтения файла (в токенах, консервативно ~2 символа/токен)
READ_TOKEN_BUDGET=20000
